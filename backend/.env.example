# Copy this file to backend/.env and fill in real values. Every value left
# blank keeps the corresponding integration/agent in MOCK/SIMULATED mode --
# the application runs correctly without any of these set.

# --- Security (change before any real deployment) ---
SECRET_KEY=change-me-to-a-long-random-string
OWNER_EMAIL=owner@example.com
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-new-password'))"
OWNER_PASSWORD_HASH=

# --- Database (SQLite file by default; set a Postgres DSN for production) ---
DATABASE_URL=sqlite:///./ultron.db
# DATABASE_URL=postgresql+psycopg2://ultron:password@localhost:5432/ultron

# --- Autonomy & budgets ---
AUTONOMY_MODE=SUPERVISED
STARTUP_BUDGET_CEILING_USD=1000.00
MONTHLY_AI_BUDGET_USD=150.00
ADVERTISING_ENABLED=false

# --- AI providers (blank = MOCK_LLM fallback, no real model calls) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Etsy Open API v3 (blank = listings run in SIMULATED mode) ---
# Full setup steps: see INTEGRATIONS.md. After setting these and restarting,
# connect via the "Connect Etsy" button on the Marketplace Center page.
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/etsy/callback

# --- Print-on-demand providers ---
PRINTIFY_API_TOKEN=
PRINTFUL_API_TOKEN=

# --- Shopify (not activated until the owner explicitly enables expansion) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# --- Notifications ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
